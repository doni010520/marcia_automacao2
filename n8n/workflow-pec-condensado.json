    {
      "parameters": {
        "jsCode": "// ========================================\n// PEC CONDENSADO - Calcular Perfil\n// 12 perguntas, escala: Nunca(0), Às vezes(1), Sempre(2)\n// ========================================\n\n// Mapeamento de respostas\nconst ESCALA = {\n  'Nunca': 0,\n  'Às vezes': 1,\n  'Sempre': 2\n};\n\n// Perfis e suas perguntas\nconst PERFIS = {\n  ACAO: [1, 2, 3],\n  RELACIONAL: [4, 5, 6],\n  TEMPO: [7, 8, 9],\n  MENSAGEM: [10, 11, 12]\n};\n\nconst items = $input.all();\nconst resultados = [];\n\nfor (const item of items) {\n  const data = item.json;\n\n  // Extrair respostas das perguntas 1 a 12\n  const respostas = {};\n  for (const [key, value] of Object.entries(data)) {\n    const match = key.match(/^(\\d+)\\./);\n    if (match) {\n      const num = parseInt(match[1]);\n      respostas[num] = ESCALA[value] !== undefined ? ESCALA[value] : 0;\n    }\n  }\n\n  // Calcular pontuações\n  const pont = {\n    ACAO: PERFIS.ACAO.reduce((soma, num) => soma + (respostas[num] || 0), 0),\n    RELACIONAL: PERFIS.RELACIONAL.reduce((soma, num) => soma + (respostas[num] || 0), 0),\n    TEMPO: PERFIS.TEMPO.reduce((soma, num) => soma + (respostas[num] || 0), 0),\n    MENSAGEM: PERFIS.MENSAGEM.reduce((soma, num) => soma + (respostas[num] || 0), 0)\n  };\n\n  // Identificar predominante (maior pontuação)\n  const predominante = Object.keys(pont).reduce((a, b) =>\n    pont[a] > pont[b] ? a : b\n  );\n\n  resultados.push({\n    json: {\n      participante: data['Nome completo:'] || 'Participante',\n      pontuacoes: pont,\n      predominante: predominante\n    }\n  });\n}\n\nreturn resultados;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [944, 432],
      "id": "code-pec-mini",
      "name": "Calcular Perfil"
    },
